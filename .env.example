# ===== UPL CODE ACADEMY MK — variables d'environnement =====
# Copier ce fichier en .env.local puis renseigner les valeurs.
# Les variables NEXT_PUBLIC_* sont visibles dans le navigateur : n'y mettez JAMAIS de secret.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (base de données, authentification, stockage) ---
# Sans ces deux variables, l'application démarre en « mode démonstration »
# (cours, éditeur et exercices accessibles ; comptes et sauvegarde désactivés).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète serveur : écriture des résultats officiels, lecture des solutions
# et tests cachés pour la correction. Ne jamais l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# Bouton « Continuer avec Google » : mettre true UNIQUEMENT après avoir activé le
# fournisseur Google dans Supabase (Authentication → Providers → Google). Voir docs/DEPLOIEMENT.md.
NEXT_PUBLIC_AUTH_GOOGLE=false

# Contenu : "database" (par défaut si Supabase est configuré) ou "static"
# (contenu versionné dans src/content, utile avant l'import du seed).
# CONTENT_SOURCE=static

# --- Exécution isolée du code (Judge0 CE ou équivalent) ---
# Sans Judge0 : pseudocode, Python et JavaScript s'exécutent dans le navigateur ;
# C et Java nécessitent Judge0.
JUDGE0_URL=
# Jeton d'authentification d'une instance Judge0 auto-hébergée (AUTHN_TOKEN)
JUDGE0_AUTH_TOKEN=
# Ou, pour l'offre RapidAPI :
JUDGE0_RAPIDAPI_KEY=
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com
# Identifiants des langages dans votre instance Judge0 (valeurs Judge0 CE 1.13 par défaut)
JUDGE0_LANG_PYTHON=71
JUDGE0_LANG_C=50
JUDGE0_LANG_JAVASCRIPT=63
JUDGE0_LANG_JAVA=62

# --- Sécurité ---
# Tentatives de connexion / inscription autorisées par adresse IP et par 10 minutes (défaut : 8).
# AUTH_RATE_LIMIT_PER_10MIN=8

# --- Professeur IA (facultatif : sans modèle connecté, les cours restent accessibles) ---
# Budget 0 : utilisez un fournisseur avec offre gratuite, via l'API compatible OpenAI.
# Les quotas gratuits sont fixés par chaque fournisseur et changent : vérifiez-les.
#   Google Gemini : AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   AI_MODEL=<modèle Flash/Flash-Lite>
#   Groq :          AI_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter :    AI_BASE_URL=https://openrouter.ai/api/v1   (modèles dont l'identifiant finit par « :free »)
#   Mistral :       AI_BASE_URL=https://api.mistral.ai/v1
AI_PROVIDER=openai_compatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# « gratuit » uniquement si l'offre du fournisseur est gratuite ; sinon le fournisseur est
# considéré comme payant et reste bloqué tant que l'administrateur ne l'autorise pas (avec un budget).
AI_BILLING=gratuit
AI_PROVIDER_LABEL=
# Fournisseur payant (Anthropic) : AI_PROVIDER=anthropic + ANTHROPIC_API_KEY ; bloqué par défaut.
ANTHROPIC_API_KEY=
# Autoriser le professeur IA sans compte (développement local uniquement !)
AI_ALLOW_ANONYMOUS=false
